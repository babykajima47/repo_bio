# Copy thành .env (dùng với docker-compose.yml) hoặc set trực tiếp trên Vibe Host.
# Biến có dấu (*) là bắt buộc.

APP_ENV=production

# Tài khoản quản trị đầu tiên (*) — Vibe Host tự sinh ADMIN_PASSWORD khi deploy.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Kết nối MySQL 8.0 (*) — do Vibe Host cấp tự động qua envMapping khi provisioning DB.
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=vn_biolink_hub
DB_USERNAME=biolink
DB_PASSWORD=changeme
